# Public Firebase web-app configuration. Never put an Admin service-account key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# true only for local tests; keep false for deployed builds.
VITE_USE_FIREBASE_EMULATORS=false
# Optional override for the bundled homepage video (/media/thread-reel.mp4).
VITE_HOMEPAGE_VIDEO_URL=
