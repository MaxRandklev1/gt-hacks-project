{
  "name": "gt-hacks-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-thread-tryon --only firestore,storage \"vitest run tests/firebase-rules.test.ts\"",
    "emulators": "firebase emulators:start --project demo-thread-tryon --only auth,firestore,storage",
    "deploy": "pnpm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes,storage",
    "qr": "node scripts/create-garment-tag.mjs"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "firebase": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
